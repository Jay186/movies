# —— 分镜 QC / 承接相关开关（2026-09-24 事故整改新增）——
# AIRLOCK_SEC：Airlock 开场冻结已整体废除，默认 0 = 不做开场冻结（承接即刻完成、动作与台词从第 0 秒即可开始）；
#             >0 恢复旧 Airlock 冻结行为（仅用于对照排查，非推荐值）。跨场连戏改由「尾帧参考图 + 提示词承接句」承担。
AIRLOCK_SEC=0
# DIALOGUE_VERBATIM_CHECK：台词逐字对账。默认开（!=0 即开）= 分镜台词必须逐字存在于剧本原文；=0 关闭该校验。
DIALOGUE_VERBATIM_CHECK=1
# DIALOGUE_REVERSE_BLOCK：对话反打是否强制切镜。默认 0 = 允许合并（对白连续戏可整段一镜）；=1 强制切镜（会锁成短镜，仅在确需时开启）。
DIALOGUE_REVERSE_BLOCK=0
# SAVE_QC_BLOCK_ON_ERROR：分镜保存接口的 QC 闸。默认 0 = 只告警不阻断；=1 时带 QC 硬错误（errorCount>0）的保存请求返回 409。
SAVE_QC_BLOCK_ON_ERROR=0
