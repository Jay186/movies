# 分镜项目后端环境变量模板
# 复制为 server/.env 并填入真实值；真实 .env 绝不提交/分发
#（生成强 token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"）

# server/.env 模板
# 注意：原 .env 文件在处理 workflowId 编码时被意外清空，请补全下方密钥后使用。

PORT=<填入你的值>
API_TOKEN=<64位随机hex，启用后前端 localStorage 需存 api_token>

# LLM 主配置（分镜 prompt 生成、整改、对话等共用）
# 2026-09-15 三模型同负载实测（1 场 3 镜完整分镜 JSON，百炼免费额度模式）：
# qwen3.8-max        : 可关思考，out 1060 tok / 20.4s —— 效率最优，但免费额度此前已报过欠费
# deepseek-v4-pro-0813: 可关思考（实测接受 false），out 1400 tok / 32.6s —— 额度全新，当前选用
# 端点与 key 必须同源：baseURL 固定百炼，key 用 DASHSCOPE_API_KEY（见下方注释）。
LLM_BASE_URL=<填入你的值>
LLM_MODEL=<填入你的值>
# 轻量模型分级（翻译/格式化类任务专用）：qwen3.8-flash 额度可用，实测单次约 3.5s（主模型约 60s）。
LLM_LIGHT_MODEL=<填入你的值>
LLM_VLM_MODEL=<填入你的值>
# 二选一填写：ZHIPU_API_KEY 或 DASHSCOPE_API_KEY
# 2026-09-15：ZHIPU_API_KEY 实测 401 失效，且 config 优先读它会让所有调用失败 → 已停用；
# 若将来改用智谱官方端点，取消注释并填入有效 key。
DASHSCOPE_API_KEY=<填入你的值>

# 工作流专用 LLM（可选；不配置则回退到上方 LLM 配置）
WORKFLOW_LLM_API_KEY=<填入你的值>
WORKFLOW_LLM_MODEL=<填入你的值>

# RunningHub
RUNNINGHUB_API_KEY=<填入你的值>

# 三槽分镜工作流：导入《多图三槽分镜_v3.json》到 RunningHub 并手动跑通一次后，把 workflowId 填到下行
RH_FRAME_GRID_WORKFLOW_ID=<填入你的值>

# 单镜 2x2 四宫格分镜工作流（2026-09-04 重新发布版；2026-09-09 曾试换 2097503532629970945 失败已回退）
# 节点映射沿用 nodeMap.shotGridGenerator（#114/#79/#1/#2/#99/#91...）
RH_SHOT_GRID_WORKFLOW_ID=<填入你的值>

# H3 导演台 3.0 + 4 步加速 LoRA 段落出片工作流（server/workflows/h3-director-3.0-fixed.json）

# 单镜出片增强工作流：MiniMax H3 · 4steps 宫格漫剧 · 视频人声参考增强版
# （对应本地《MinimaxH3-4steps九宫格漫剧-视频人声参考增强版.json》，2026-09-04 导入 RunningHub）
RH_H3_STORYBOARD_WORKFLOW_ID=<填入你的值>
# 168 号 RHMiniMaxH3PromptOptimizer 的 LLM 模型（2026-09-04 线上下拉确认；原 gemini-3.1-flash-lite-preview 已下架）
# gemini-3.7-flash 实测返回空内容（think 标签被洗成空串），改用免费 qwen3.8-flash-next（实测出内容正常）
RH_H3_OPTIMIZER_MODEL=<填入你的值>
# h3v2 出片轮询超时（毫秒）：与云端任务上限对齐，60 分钟
RH_H3V2_TIMEOUT_MS=<填入你的值>

# Motion Context 续镜（音频连贯 #1，2026-09-11）：把
# 《workflows/4-MiniMaxh-H3-V4-全槽-MC-fc续镜版.json》导入 RunningHub 后把 workflowId 填到下行
RH_H3_V4_MC_WORKFLOW_ID=<填入你的值>
# 验收期保持 false（用单镜请求 useMotionContext: true 实测接缝）；验收通过后改 true 全局开启
# 2026-09-11 13:14 布哥验收通过（3-2→4-1 接缝画面+环境音"像"），全局开启
RH_MOTION_CONTEXT_ENABLED=<填入你的值>

ZIKL_API_KEY=<填入你的值>
ZIKL_BASE_URL=<填入你的值>
ZIKL_IMAGE_MODEL=<填入你的值>
ZIKL_IMAGE_SIZE=<填入你的值>

# Visionary（https://visionary.beer）：支持 gpt-image-2 / nano-banana-pro / nano-banana-pro-cl / nano-banana-2-lite
VISIONARY_API_KEY=<填入你的值>
VISIONARY_BASE_URL=<填入你的值>
VISIONARY_IMAGE_MODEL=<填入你的值>
VISIONARY_IMAGE_RESOLUTION=<填入你的值>
VISIONARY_IMAGE_SIZE=<填入你的值>
VISIONARY_OPTIMIZE_CHINESE_TEXT=<填入你的值>
VISIONARY_POLL_INTERVAL_MS=<填入你的值>
VISIONARY_MAX_POLL_MS=<填入你的值>

# 全局默认生图引擎：zikl | runninghub | visionary
IMAGE_PROVIDER=<填入你的值>

