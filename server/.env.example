

PORT=<填入你的值>
API_TOKEN=<64位随机hex，启用后前端 localStorage 需存 api_token>

# ── 文本大模型（单档，唯一调用入口 server/ai/doubao.js）────────────────
# 网关（OpenAI 兼容协议）与 Key：LLM_API_KEY 与 DASHSCOPE_API_KEY 配其一即可，
# 前者优先级更高（其他厂商网关用 LLM_API_KEY 更贴切）。
LLM_BASE_URL=<填入你的值，如 https://dashscope.aliyuncs.com/compatible-mode/v1>
LLM_API_KEY=<可选，与 DASHSCOPE_API_KEY 二选一>
DASHSCOPE_API_KEY=<填入你的值>
# 统一模型：剧本 / 分镜 / 资产 / 修补 / 翻译 / 灯光 / 轴检 / 帧质检 / 场景图闸 / 布局图闸
# 均走此模型；若该模型支持图片输入，三道视觉质检闸即启用，否则静默跳过。
LLM_MODEL=<填入你的值，如 deepseek-v4.1-flash>
# 全局并发上限（默认 6）
LLM_MAX_CONCURRENT=<可选，默认 6>
# 单次调用超时（毫秒），按任务耗时量级分档；不填即用括号内默认值。
LLM_TIMEOUT_SHORT_MS=<可选，默认 30000>
LLM_TIMEOUT_TRANSLATE_MS=<可选，默认 60000>
LLM_TIMEOUT_REPAIR_MS=<可选，默认 90000>
LLM_TIMEOUT_STANDARD_MS=<可选，默认 180000>
LLM_TIMEOUT_EXTENDED_MS=<可选，默认 240000>
LLM_TIMEOUT_LONG_SCRIPT_MS=<可选，默认 300000>

# 以下 RunningHub 各项仅作【首启初值 / 旧库迁移取值源】，运行时不读：
# 生效值一律来自「AI 模型配置」抽屉的「视频通道」，改 .env 不会影响已启动的服务。
RUNNINGHUB_API_KEY=<填入你的值>

# ↓ 以下 RunningHub 工作流 id 仅作【首启初值 / 旧库迁移取值源】，生效值见「AI 模型配置」的「视频通道」
# 休眠配置（无代码引用），保留以便将来接线：
RH_FRAME_GRID_WORKFLOW_ID=<可选，四宫格帧网格工作流 id>
# 四宫格 AI 应用 id（在用：分镜网格出图）
RH_SHOT_GRID_APP_ID=<可选，默认 2048139846660657154>
# H3 分镜生成工作流（休眠配置，无代码引用）
RH_STORYBOARD_GENERATOR_WORKFLOW_ID=<可选，默认 2092895275319910402>
# H3 打斗超时（毫秒）
RH_H3_COMBAT_TIMEOUT_MS=<可选，默认 3600000>
# 全能 V5-SelfLift 出片工作流（唯一出片通道）
RH_H3_V4_VC_WORKFLOW_ID=<可选，默认 2102948824707854338>
# Qwen 生图工作流（文生图，比例固定工作流内置 9:16）——休眠配置（无代码引用）
RH_QWEN_IMAGE_WORKFLOW_ID=<可选，默认 2102954366490734594>
# subject_definitions 是否原样复述资产完整外观（生图用的 description_en）。
# 默认 0 = 按官方 ref-en.txt L37「main features to follow」压缩成身份锚点。
# 官方 ≤7000 字符是硬上限；复述完整外观时 5 个参考图（3角色+1场景+1道具）骨架即 5993，
# 只剩 1007 字符给 detailed_description（官方 §5.2 要求 350-500 英文词 ≈2200-3100），
# 内容一加就超限。置 1 仅用于出片质量对比，不建议常态开启。
H3_SUBJECT_FULL_DESC=<可选，默认 0>
# 单条参考资产的「身份识别特征」字符上限（官方示例量级 130-165；本项目默认 300——
# 实测标定：300 才能让多角色之间靠外观细节区分的特征句（毛色/肤色等）都存活，260 会单边丢特征）
H3_SUBJECT_FEATURES_CAP=<可选，默认 300>

# ── 剧本生成（平台通用：不预设任何题材/受众，题材由项目 theme 注入）────────
SCRIPT_MIN_CHARS=<可选，默认 800>
SCRIPT_MAX_CHARS=<可选，默认 1500>
SCRIPT_SCENE_COUNT_MIN=<可选，默认 3>
SCRIPT_SCENE_COUNT_MAX=<可选，默认 5>
SCRIPT_TEMPERATURE=<可选，默认 0.8>
SCRIPT_MAX_TOKENS=<可选，默认 6000>

# ── 打斗工作流（h3Combat）契约 ──────────────────────────────────────────
# LoRA 触发词 / 提示词模板 / 机位约束句属【工作流契约】，不是平台业务。
# 换工作流、换 LoRA、换打斗语汇时改这里即可，无需改代码（默认值为当前工作流实测值）。
RH_COMBAT_LORA_TRIGGER=<可选，默认 prfight1>
RH_COMBAT_LORA_TRIGGER_KNOCKDOWN=<可选，默认 "prfight1, prfin1">
# 命中"击倒"语义的判定词表，逗号分隔；命中则改用 KNOCKDOWN 触发词
RH_COMBAT_KNOCKDOWN_WORDS=<可选，默认 "倒进,倒地,瘫倒,击倒,轰然倒">
RH_COMBAT_IDEA_TEMPLATE=<可选，打斗 idea 的提示词模板前缀（其后拼接创作想法），留空用内置默认>
RH_COMBAT_CAMERA_LOCK=<可选，打斗机位约束句，留空用内置默认>

ZIKL_API_KEY=<填入你的值>
ZIKL_BASE_URL=<填入你的值>
ZIKL_IMAGE_MODEL=<填入你的值>
ZIKL_IMAGE_SIZE=<填入你的值>

# 启明星（OpenAI 兼容聚合中转站）：以下两项仅作【首启初值 / 旧库迁移取值源】，运行时不读——
# 生效值一律来自「AI 模型配置」抽屉。二者必须成对配置（只配一个视为不完整，整对不使用，绝不跨源拼装）：
#   成对且都有值 → 文本通道与生图通道都取 QMX_*；
#   否则文本通道取上面的文本网关（LLM_*）、生图通道取上面的生图通道（ZIKL_*），各走各的。
QMX_BASE_URL=<填入你的值，如 https://api.aisj.ai/v1>
QMX_API_KEY=<填入你的值>

QMX_PLAZA_URL=https://api.aisj.ai/api/v1/model-plaza
QMX_PLAZA_TIMEOUT_MS=8000
QMX_PLAZA_CACHE_TTL_MS=600000

IMAGE_REF_MAX_BYTES=<填入你的值>
IMAGE_REF_MAX_EDGE=<填入你的值>
ZIKL_ASSET_SIZE=<填入你的值>

DEFAULT_ASPECT_RATIO=<填入你的值>
COMBAT_SHOT_MIN_SEC=<填入你的值>
COMBAT_SHOT_MAX_SEC=<填入你的值>
COMBAT_SHOT_DEFAULT_SEC=<填入你的值>
VIDEO_MEGAPIXELS=<填入你的值>
VIDEO_DEFAULT_MEGAPIXELS=<填入你的值>
VIDEO_SHOT_MIN_SEC=<填入你的值>
VIDEO_SHOT_MAX_SEC=<填入你的值>
VIDEO_SHOT_DEFAULT_SEC=<填入你的值>

ASSET_MAX_REFS=<可选，默认 4>

# —— 分镜承接相关开关（2026-09-24 事故整改新增；分镜 QC 相关开关已于 2026-09-26 随 QC 整体移除）——
# AIRLOCK_SEC：Airlock 开场冻结已整体废除，默认 0 = 不做开场冻结（承接即刻完成、动作与台词从第 0 秒即可开始）；
#             >0 恢复旧 Airlock 冻结行为（仅用于对照排查，非推荐值）。跨场连戏改由「尾帧参考图 + 提示词承接句」承担。
AIRLOCK_SEC=0
# DIALOGUE_REVERSE_BLOCK：对话反打是否强制切镜。默认 0 = 允许合并（对白连续戏可整段一镜）；=1 强制切镜（会锁成短镜，仅在确需时开启）。
DIALOGUE_REVERSE_BLOCK=0
